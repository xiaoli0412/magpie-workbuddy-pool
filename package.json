    "magpie-plugin",
    "magpie-page",
    "opencode",
    "opencode-plugin",
    "workbuddy",
    "codebuddy",
    "account-pool",
    "账号池",
    "成长计划",
    "积分"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "import": "bun tools/import.mjs",
    "verify": "bun tools/verify.mjs",
    "test": "bun tools/test-import.mjs && bun tools/test-page.mjs && bun tools/test-assets.mjs && bun tools/test-dom.mjs",
    "test:integration": "bun tools/test-roundtrip.mjs"
  },
  "magpie": {
    "page": {
      "title": "WorkBuddy 账号池",
